{
  "name": "@nostrdevkit/nostr-sdk-web",
  "version": "0.45.0",
  "description": "Web bindings for the Nostr SDK.",
  "keywords": [
    "nostr",
    "sdk",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "homepage": "https://nostrdevkit.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostrdevkit/nostr-sdk-ffi.git",
    "directory": "js/web"
  },
  "bugs": {
    "url": "https://github.com/nostrdevkit/nostr-sdk-ffi/issues"
  },
  "author": {
    "name": "Yuki Kishimoto",
    "email": "yukikishimoto@protonmail.com",
    "url": "https://github.com/yukibtc"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://nostrdevkit.org/donate"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node ../scripts/patch-ubrn.mjs",
    "clean": "node scripts/clean.mjs",
    "generate": "ubrn build web --config ubrn.config.yaml --release",
    "compile": "tsc -p tsconfig.json && node scripts/copy-generated-assets.mjs",
    "build": "npm run clean && npm run generate && npm run compile",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/run-web-test.mjs",
    "pack:local": "npm run build && npm pack"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-3"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "@ubjs/node": "0.31.0-3",
    "esbuild": "0.25.8",
    "typescript": "5.9.3",
    "uniffi-bindgen-react-native": "0.31.0-3"
  },
  "engines": {
    "node": ">=20"
  }
}
